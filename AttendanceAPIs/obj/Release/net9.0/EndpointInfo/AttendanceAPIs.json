  "components": {
    "schemas": {
      "ApiAttendanceDto": {
        "type": "object",
        "properties": {
          "scg": {
            "type": "string",
            "nullable": true
          },
          "dt": {
            "type": "string",
            "nullable": true
          },
          "tpc": {
            "type": "integer",
            "format": "int32"
          },
          "apc": {
            "type": "integer",
            "format": "int32"
          },
          "ph": {
            "type": "array",
            "items": {
              "$ref": "#/components/schemas/ApiAttendancePhotoDto"
            },
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "ApiAttendancePhotoDto": {
        "type": "object",
        "properties": {
          "pg": {
            "type": "string",
            "format": "uuid"
          },
          "apc": {
            "type": "integer",
            "format": "int32"
          },
          "std": {
            "type": "array",
            "items": {
              "type": "string",
              "format": "uuid"
            },
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "ApiStudentDto": {
        "type": "object",
        "properties": {
          "sg": {
            "type": "string",
            "format": "uuid"
          },
          "n": {
            "type": "string",
            "nullable": true
          },
          "c": {
            "type": "string",
            "nullable": true
          },
          "a": {
            "type": "integer",
            "format": "int32"
          },
          "g": {
            "type": "string",
            "nullable": true
          }
        },
        "additionalProperties": false
      },
      "UserLogin": {
        "required": [
          "username"
        ],
        "type": "object",
        "properties": {
          "username": {
            "minLength": 1,
            "type": "string"
          },
          "password": {
            "type": "string",
            "nullable": true
          }
        },
        "additionalProperties": false
      }
    }
  }
